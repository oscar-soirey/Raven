<!-- Page 6: the installation (or the uninstallation) as it runs. -->
<VBox Spacing="12" Slot.Padding="48,44">
	<Label Name="progress.title" Text="Installing" TextSize="26"/>
	<Label Name="progress.operation" Text="" Opacity="0.7"/>
	<ProgressBar Name="progress.bar" Value="0"/>
	<Label Name="progress.detail" Text="" Opacity="0.5"/>
	<VBox Name="progress.components" Spacing="4" Slot.Padding="0,6"/>
