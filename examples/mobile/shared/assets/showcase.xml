<?xml version="1.0" encoding="UTF-8"?>
<!--
  Raven mobile showcase: the whole UI, shared by the iOS and the Android app.
  A file of the app's package (the APK's assets/, the iOS bundle), created with
  Rwidget_create_from_xml_file; showcase.c finds the named widgets and wires
  them. The picture and the font of the titles are in the package too (the
  font is copied there by the build scripts, from tools/designer/fonts).

  Layout: an Overlay holding the pages and a bottom tab bar (TabView only puts
  its tabs at the top, so the bar is five buttons driving a Switcher), and a
  Toast over everything.
-->
<Overlay Name="root">
	<VBox>
		<Switcher Name="pages" Slot.Fill="1">

			<!-- 0: List, with a detail page (a second Switcher: navigation forward / back) -->
			<Switcher Name="listnav">
				<VBox>
					<Label Text="List" Font="fonts/BricolageGrotesque-Bold-subset.ttf" TextSize="28" Slot.Padding="16,8,16,4"/>
					<Label Name="list_hint" Text="1,000 rows. Tap one." Opacity="0.6" Slot.Padding="16,0,16,0"/>
					<!-- the last events of the application's lifecycle (Rset_app_event_callback) -->
					<Label Name="lifecycle" Text="Lifecycle: started" Opacity="0.6" Wrap="true" Slot.Padding="16,2,16,8"/>
					<TileView Name="list" Layout="Rows" TileHeight="60" IconSize="40" Spacing="2" Slot.Fill="1"/>
				</VBox>
				<!-- (its touch callback, the edge swipe, makes the whole page take the finger, its empty parts too) -->
				<VBox Name="detail" Spacing="12">
					<HBox Slot.Padding="8,4,8,0">
						<Button Name="back" Text="‹ Back" Style="Flat"/>
					</HBox>
					<VBox Spacing="12" Slot.Padding="16,0,16,0">
						<Border Name="detail_swatch" CornerRadius="100" Width="72" Height="72" Slot.HAlign="Left"/>
						<Label Name="detail_title" Text="Row" Font="fonts/BricolageGrotesque-Bold-subset.ttf" TextSize="28"/>
						<Label Name="detail_subtitle" Text="" Opacity="0.7"/>
						<Label Name="detail_body" Wrap="true" Text=""/>
						<Label Text="Back: the button above, Escape, the Android back button / gesture, or a swipe from the left edge." Wrap="true" Opacity="0.6"/>
					</VBox>
				</VBox>
			</Switcher>

			<!-- 1: Controls -->
			<ScrollBox>
				<VBox Spacing="18" Slot.Padding="16,8,16,16">
					<Label Text="Controls" Font="fonts/BricolageGrotesque-Bold-subset.ttf" TextSize="28"/>
					<!-- characters of the fonts of the system: other scripts, symbols, color emoji -->
					<Label Text="Hello 你好 こんにちは 안녕 مرحبا สวัสดี" Wrap="true"/>
					<Label Text="π € → ✓ 😀 👍 🎉 🚀 🐦" Wrap="true"/>
					<HBox Spacing="12">
						<Button Name="counter" Text="Tap me" Style="Primary"/>
						<Label Name="counter_label" Text="Tapped 0 times" Slot.VAlign="Center"/>
					</HBox>
					<HBox Spacing="12">
						<Label Text="Notifications" Slot.Fill="1" Slot.VAlign="Center"/>
						<Checkbox Name="switch" Style="Switch" Checked="true"/>
					</HBox>
					<Checkbox Name="check" Text="Remember me"/>
					<VBox Spacing="6">
						<HBox>
							<Label Text="Volume" Slot.Fill="1"/>
							<Label Name="slider_value" Text="40"/>
						</HBox>
						<Slider Name="slider" Min="0" Max="100" Step="1" Value="40"/>
					</VBox>
					<VBox Spacing="6">
						<HBox>
							<Label Text="Downloading" Slot.Fill="1"/>
							<Label Name="progress_value" Text="0 %"/>
						</HBox>
						<ProgressBar Name="progress" Value="0"/>
					</VBox>
					<HBox Spacing="12">
						<Button Name="show_dialog" Text="Show dialog"/>
						<Button Name="show_toast" Text="Show toast"/>
					</HBox>
					<Label Name="dialog_result" Text="Dialog: not opened yet" Opacity="0.7"/>
				</VBox>
			</ScrollBox>

			<!-- 2: Glass: a picture of the package, with blurred panels over it -->
			<Overlay>
				<Image Name="photo" Source="photo.png" Stretch="Cover"/>
				<VBox Spacing="16" Slot.Padding="16,16,16,16">
					<BackgroundBlur Name="blur_title" Style="Frosted" Radius="20" CornerRadius="22" Padding="16" Slot.HAlign="Fill">
						<VBox Spacing="4">
							<Label Text="Glass" Font="fonts/BricolageGrotesque-Bold-subset.ttf" TextSize="28"/>
							<Label Text="Frosted panel over a PNG from the app's package." Wrap="true" Opacity="0.75"/>
						</VBox>
					</BackgroundBlur>
					<HBox Spacing="16">
						<BackgroundBlur Name="blur_plain" Style="Plain" Radius="20" CornerRadius="18" Padding="14" Slot.Fill="1">
							<Label Text="Plain" Color="white"/>
						</BackgroundBlur>
						<BackgroundBlur Name="blur_glass" Style="Glass" Radius="20" CornerRadius="18" Padding="14" Slot.Fill="1">
							<Label Text="Glass"/>
						</BackgroundBlur>
					</HBox>
					<Spacer Slot.Fill="1"/>
					<BackgroundBlur Style="Frosted" Radius="30" CornerRadius="22" Padding="16">
						<VBox Spacing="6">
							<HBox>
								<Label Text="Blur radius" Slot.Fill="1"/>
								<Label Name="blur_value" Text="20"/>
							</HBox>
							<Slider Name="blur_slider" Min="0" Max="60" Step="1" Value="20"/>
							<Label Name="frame_stats" Text="" Wrap="true" Opacity="0.7"/>
						</VBox>
					</BackgroundBlur>
				</VBox>
			</Overlay>

			<!-- 3: Form -->
			<ScrollBox>
				<VBox Spacing="14" Slot.Padding="16,8,16,16">
					<Label Text="Form" Font="fonts/BricolageGrotesque-Bold-subset.ttf" TextSize="28"/>
					<Label Text="Name"/>
					<TextInput Name="name" Placeholder="Your name" ReturnKey="Next"/>
					<Label Text="Email"/>
					<TextInput Name="email" Placeholder="you@example.com" InputType="Email" ReturnKey="Next"/>
					<Label Text="Phone"/>
					<TextInput Name="phone" Placeholder="+62 812 3456 7890" InputType="Phone" ReturnKey="Next"/>
					<!-- (low on the page: with the keyboard up, Raven scrolls the focused field above it) -->
					<Label Text="City"/>
					<TextInput Name="city" Placeholder="Yogyakarta" ReturnKey="Next"/>
					<Label Text="Note"/>
					<TextInput Name="note" Placeholder="Anything else" ReturnKey="Done"/>
					<Button Name="submit" Text="Submit" Style="Primary" Slot.HAlign="Left"/>
					<Label Name="keyboard_state" Text="Keyboard: hidden"/>
					<Label Name="form_state" Text="" Wrap="true" Opacity="0.6"/>
				</VBox>
			</ScrollBox>

			<!-- 4: Device: the services of the device (raven_device.h); each answer comes later, in a callback -->
			<ScrollBox>
				<VBox Spacing="10" Slot.Padding="16,8,16,16">
					<Label Text="Device" Font="fonts/BricolageGrotesque-Bold-subset.ttf" TextSize="28"/>
					<Label Name="dev_status" Text="Each button asks the system; its answer shows here." Wrap="true" Opacity="0.7"/>

					<Label Text="Permissions" TextSize="18" Slot.Padding="0,8,0,0"/>
					<HBox Spacing="8">
						<Label Name="perm_camera" Text="Camera: ?" Slot.Fill="1" Slot.VAlign="Center"/>
						<Button Name="ask_camera" Text="Ask"/>
					</HBox>
					<HBox Spacing="8">
						<Label Name="perm_notify" Text="Notifications: ?" Slot.Fill="1" Slot.VAlign="Center"/>
						<Button Name="ask_notify" Text="Ask"/>
					</HBox>
					<HBox Spacing="8">
						<Label Name="perm_location" Text="Location: ?" Slot.Fill="1" Slot.VAlign="Center"/>
						<Button Name="ask_location" Text="Ask"/>
					</HBox>
					<WrapBox Spacing="8">
						<Button Name="notify" Text="Notify me"/>
						<Button Name="settings" Text="Settings"/>
					</WrapBox>

					<Label Text="Camera and photos" TextSize="18" Slot.Padding="0,8,0,0"/>
					<WrapBox Spacing="8">
						<Button Name="take_photo" Text="Take a photo" Style="Primary"/>
						<Button Name="pick_photo" Text="Pick a photo"/>
					</WrapBox>
					<Label Name="photo_info" Text="No photo yet." Wrap="true" Opacity="0.7"/>
					<Image Name="photo_view" Stretch="Fit" Height="200" Visibility="Collapsed"/>

					<Label Text="Files" TextSize="18" Slot.Padding="0,8,0,0"/>
					<WrapBox Spacing="8">
						<Button Name="open_file" Text="Pick a file"/>
						<Button Name="save_file" Text="Save a text file"/>
					</WrapBox>
					<Label Name="file_info" Text="No file yet." Wrap="true" Opacity="0.7"/>
					<Image Name="file_view" Stretch="Fit" Height="160" Visibility="Collapsed"/>

					<Label Text="Haptics" TextSize="18" Slot.Padding="0,8,0,0"/>
					<WrapBox Spacing="8">
						<Button Name="haptic_light" Text="Light"/>
						<Button Name="haptic_medium" Text="Medium"/>
						<Button Name="haptic_heavy" Text="Heavy"/>
						<Button Name="haptic_selection" Text="Selection"/>
						<Button Name="haptic_success" Text="Success"/>
						<Button Name="haptic_warning" Text="Warning"/>
						<Button Name="haptic_error" Text="Error"/>
					</WrapBox>

					<Label Text="Links, sharing, clipboard" TextSize="18" Slot.Padding="0,8,0,0"/>
					<WrapBox Spacing="8">
						<Button Name="open_url" Text="Open Raven's page"/>
						<Button Name="share" Text="Share"/>
						<Button Name="copy" Text="Copy"/>
						<Button Name="paste" Text="Paste"/>
					</WrapBox>
					<Label Name="clip_info" Text="Clipboard: not read yet (reading it on a paste, as iOS asks)." Wrap="true" Opacity="0.7"/>

					<Label Text="Network" TextSize="18" Slot.Padding="0,8,0,0"/>
					<Button Name="load_url" Text="Load an image from https://" Slot.HAlign="Left"/>
					<Label Name="net_info" Text="Not loaded yet." Wrap="true" Opacity="0.7"/>
					<Image Name="net_view" Stretch="Fit" Height="96" Visibility="Collapsed"/>
				</VBox>
			</ScrollBox>
		</Switcher>

		<Separator/>
		<!-- bottom tab bar -->
		<UniformGrid Name="tabbar" Columns="5" Slot.Padding="4,6,4,6">
			<Button Name="tab0" Text="List" Style="Flat"/>
			<Button Name="tab1" Text="Controls" Style="Flat"/>
			<Button Name="tab2" Text="Glass" Style="Flat"/>
			<Button Name="tab3" Text="Form" Style="Flat"/>
			<Button Name="tab4" Text="Device" Style="Flat"/>
		</UniformGrid>
	</VBox>

	<Toast Name="toast" Slot.HAlign="Center" Slot.VAlign="Bottom" Slot.Padding="16,0,16,72"/>
</Overlay>
