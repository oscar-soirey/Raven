<?xml version="1.0" encoding="UTF-8"?>
<!--
  Raven example - themes

  Theme files, styles and classes, a theme given to a part of the window,
  Markdown in a label and in an editor, and files that are loaded again
  when they change: this one, the two theme files and notes.md are watched.
-->
<Window Title="Raven - themes" Width="1180" Height="760" MinWidth="820" MinHeight="520">
	<HBox>
		<VBox Width="250" Spacing="10" Slot.Padding="16">
			<Label Class="eyebrow" Text="APPEARANCE"/>
			<Label Text="Themes" TextSize="24"/>
			<Label Text="Look" Opacity="0.65" Slot.Padding="0,8,0,0"/>
			<ComboBox Name="looks" OnChanged="themes.look"
				Items="Raven dark|Raven light|Raven glass dark|Raven glass light|Raven high contrast dark|Raven high contrast light|Windows dark|Windows light|macOS dark|macOS light|GNOME dark|GNOME light|Native dark|Native light"/>
			<Label Text="Theme file laid over it" Opacity="0.65" Slot.Padding="0,8,0,0"/>
			<ComboBox Name="themes" OnChanged="themes.use"/>
			<Label Text="Accent" Opacity="0.65" Slot.Padding="0,8,0,0"/>
			<HBox Spacing="8">
				<ColorPicker Name="accent" Popup="true" Alpha="false" Color="#22D3EE" OnChanged="themes.accent"/>
				<Label Text="Rtheme_set_accent" Font="monospace" TextSize="12" Opacity="0.7" Slot.VAlign="Center"/>
			</HBox>
			<Button Text="Save as my-theme.xml" Style="Flat" OnClicked="themes.save" Slot.Padding="0,8,0,0"
				Tooltip="Writes the theme in use, with the changes made here, as a theme file"/>
			<Label Name="status" Text="" Wrap="true" Opacity="0.65"/>
			<Spacer Slot.Fill="1"/>
			<Label Wrap="true" Opacity="0.6" Markdown="true">Edit **ocean.xml**, **paper.xml**, **tweaks.xml** or **themes.xml** while this runs: the window follows.</Label>
		</VBox>
		<Separator Orientation="Vertical"/>

		<ScrollBox Slot.Fill="1">
			<VBox Spacing="14" Slot.Padding="20">
				<Border Class="card" Padding="18">
					<VBox Spacing="10">
						<Label Class="eyebrow" Text="THE THEME IN USE"/>
						<Label Text="Controls" TextSize="19"/>
						<HBox Spacing="8">
							<Button Text="Primary" Style="Primary"/>
							<Button Text="Default"/>
							<Button Text="Flat" Style="Flat"/>
							<Button Text="Delete" Style="Primary" Class="danger" Tooltip="Class=&quot;danger&quot;"/>
						</HBox>
						<HBox Spacing="12">
							<Checkbox Text="Checkbox" Checked="true"/>
							<Checkbox Text="Switch" Style="Switch" Checked="true"/>
							<Checkbox Text="Danger" Style="Switch" Checked="true" Class="danger"/>
						</HBox>
						<HBox Spacing="12">
							<Checkbox Text="Radio" Style="Radio" Checked="true"/>
							<Checkbox Text="Radio" Style="Radio"/>
						</HBox>
						<Slider Value="0.6"/>
						<ProgressBar Value="0.4"/>
						<ListView Items="First|Second|Third" Height="110"/>
						<HBox Spacing="8">
							<TextInput Placeholder="Text" Slot.Fill="1"/>
							<ComboBox Items="One|Two|Three" Selected="0" Width="120"/>
							<SpinBox Min="0" Max="100" Value="42" Width="90"/>
						</HBox>
					</VBox>
				</Border>

				<!-- a part of the window with a theme of its own, whatever the theme of the application -->
				<Border Class="card" Padding="18" Theme="paper.xml">
					<VBox Spacing="10">
						<Label Class="eyebrow" Text="THEME=&quot;PAPER.XML&quot;"/>
						<Label Text="A card that keeps its theme" TextSize="19"/>
						<HBox Spacing="8">
							<Button Text="Primary" Style="Primary"/>
							<Button Text="Default"/>
							<Button Text="Delete" Style="Primary" Class="danger"/>
							<Checkbox Text="Switch" Style="Switch" Checked="true"/>
						</HBox>
						<Slider Value="0.3"/>
					</VBox>
				</Border>

				<Border Class="card" Padding="18" Theme="GlassDark">
					<VBox Spacing="10">
						<Label Class="eyebrow" Text="THEME=&quot;GLASSDARK&quot;"/>
						<HBox Spacing="8">
							<Button Text="Glass" Style="Primary"/>
							<Button Text="Default"/>
							<Checkbox Text="Switch" Style="Switch" Checked="true"/>
							<Slider Value="0.7" Slot.Fill="1" Slot.VAlign="Center"/>
						</HBox>
					</VBox>
				</Border>
			</VBox>
		</ScrollBox>
		<Separator Orientation="Vertical"/>

		<Splitter Orientation="Vertical" Width="400">
			<ScrollBox Slot.Fill="3">
				<Label Name="notes" Markdown="true" Wrap="true" Slot.Padding="18"/>
			</ScrollBox>
			<TextEditor Name="editor" Markdown="true" Wrap="true" Slot.Fill="2" Placeholder="Markdown, styled as you type"/>
		</Splitter>
	</HBox>
</Window>
